#include <stdio.h>
int stack[100], choice, n, top, x, i;
void push(void);
void pop(void);
void display (void);
int main(){
top = -1;
printf("Enter the size of Stack [Maximum = 100} : ");
scanf("%d",&n);
printf("\nSTACK OPERATION USING ARRAY\n");
printf("1.PUSH\n2.POP\n3.DISPLAY\n4.EXIT");
do{
printf("\nEnter the choice : ");
scanf("%d",&choice);
switch(choice){
case 1:
{
push();
break;
}
case 2:{
pop();
break;
}
case 3:{
display();
break;
}
case 4:{
printf("\nExit Point.");
break;
}
default:{
printf("\nPlease enter a valid choice (1,2,3 or 4)");
}
}
}while(choice!=4);
return 0;
}
void push(){
if (top >= n-1){
printf("\nStack overflow!");
}
else{
printf("\nEnter value to be pushed : ");
scanf("%d",&x);
top++;
stack[top]=x;
}
}
void pop(){
if(top<=-1){
printf("\nStack underflow.");
}
else{
printf("\nPopped element : %d",stack[top]);
top--;
}
}
void display(){
if (top>=0){
printf("\nThe elements in stack are :\n");
for (i=top;i>=0;i--){
printf("\n%d",stack[i]);
}
printf("\nPress next choice : ");
}
else{
printf("\nThe stack is empty!");
}
}
